# Auth Service - Environment Variables
# In production on AWS, values are populated from AWS SSM Parameter Store via Kubernetes secrets.
PORT=3001
DB_HOST=glamdrop-db.xxxxxxxxxxxx.eu-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=auth_db
JWT_SECRET=your_secure_jwt_secret_64chars_min
PGSSLMODE=require
TZ=Europe/Rome
