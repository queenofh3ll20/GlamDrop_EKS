# Booking Service - Environment Variables
# In production on AWS, values are populated from AWS SSM Parameter Store via Kubernetes secrets.
PORT=3002
DB_HOST=glamdrop-db.xxxxxxxxxxxx.eu-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=booking_db
JWT_SECRET=your_secure_jwt_secret_64chars_min
RABBITMQ_URL=amqps://glamdrop:your_rabbitmq_password@b-xxxxxxxxxxxx.mq.eu-south-1.amazonaws.com:5671
AUTH_SERVICE_URL=http://auth-service:3001
PGSSLMODE=require
TZ=Europe/Rome
